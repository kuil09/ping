{
  "name": "ping",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "vapid": "node scripts/vapid.mjs"
  },
  "dependencies": { "web-push": "3.6.7" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.6",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3",
    "wrangler": "4.148.0",
    "ws": "8.18.3"
  }
}
